var FAVICON_ICO_B64_ = '';
var FAVICON_VER_ = '3';

function faviconUrl_() {
  var p = PropertiesService.getScriptProperties(), id = p.getProperty('FAVICON_FILE_ID'), ver = p.getProperty('FAVICON_VER');
  try {
    if (id && ver === FAVICON_VER_) { var f = DriveApp.getFileById(id); if (!f.isTrashed()) return 'https://drive.google.com/uc?export=view&id=' + id + '#favicon.ico'; }
  } catch (e) { }
  try {
    var parent = dbParentFolder_();
    var blob = Utilities.newBlob(Utilities.base64Decode(FAVICON_ICO_B64_), 'image/x-icon', 'favicon.ico');
    var file = (parent || DriveApp).createFile(blob);
    try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e2) { }
    p.setProperty('FAVICON_FILE_ID', file.getId());
    p.setProperty('FAVICON_VER', FAVICON_VER_);
    if (id) { try { DriveApp.getFileById(id).setTrashed(true); } catch (e4) { } }
    return 'https://drive.google.com/uc?export=view&id=' + file.getId() + '#favicon.ico';
  } catch (e3) { return ''; }
}

function dbParentFolder_() {
  try {
    var it = DriveApp.getFileById(db_().getId()).getParents();
    return it.hasNext() ? it.next() : null;
  } catch (e) { return null; }
}
