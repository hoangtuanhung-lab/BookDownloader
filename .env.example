# Local Docker database only. Never reuse this password outside development.
DATABASE_URL=postgresql://postgres:local-only-password@127.0.0.1:55432/bookdownloader
APP_ENV=local
# Server only; configure a separate staging Supabase project in Netlify contexts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 2 browser configuration (publishable/anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Exact browser origins allowed for mutations; comma separated, no wildcard.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# CLI only, confirmed owner Auth UUID, never VITE_.
BOOTSTRAP_ADMIN_USER_ID=

# Phase 3 server/worker only. Leave empty for local mock tests.
# Owner Drive OAuth is separate from reader Google login. Never prefix with VITE_.
# Configure a NEW staging library root only after local code closure.
DRIVE_ROOT_ID=
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=

# Phase 5–7 server/worker only; identity recorded in Drive ownership mapping.
DRIVE_OWNER_SUBJECT=
# Optional hostname -> cookie JSON, server secret only. Never VITE_ or chat.
SOURCE_COOKIES_JSON=

# Phase 7: worker is finite by default; explicit local background loop:
# npm run worker:loop (requires server Drive bindings above).
# No Cloud Scheduler or billing is enabled by this command.
